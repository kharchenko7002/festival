# Deploy-arkiver skal ikke versjonskontrolleres
*.tar.gz
2inf-festival-deploy.tar.gz

# Avhengigheter og byggeutdata (også dekket av app/.gitignore)
node_modules/
dist/

# Server-side runtime data (program-endringer og påmeldinger lagres her ved kjøring)
server/storage/*.json

# Environment variables with real secrets must never be committed
.env
