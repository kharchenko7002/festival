# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and must never be committed.

# SMTP settings for Nodemailer (e-postkvittering).
# If SMTP_HOST is empty, the app still runs but no receipt email is sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=din-epost@example.com
SMTP_PASS=app-password-her
MAIL_FROM="2INF Festival <din-epost@example.com>"

# Admin credentials for the festival manager panel.
# These match the demo values used in auth.js – change for production.
ADMIN_USERNAME=festivalsjef
ADMIN_PASSWORD=2inf2026

# Secret used to sign tokens in a production setup.
# Not used by the current demo implementation but reserved for future use.
ADMIN_TOKEN_SECRET=change-this-in-production

# Optional: override the directory where runtime JSON files are stored.
# Defaults to server/storage inside the working directory.
# STORAGE_DIR=/data/festival-storage
